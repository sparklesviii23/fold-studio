{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FOLD STUDIO Metal Dev",
  "version": "4.3.0",
  "identifier": "org.foldstudio.metalport",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1424",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FOLD STUDIO \u2014 The Molecular Observatory",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#071326",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://rest.uniprot.org https://alphafold.ebi.ac.uk https://files.rcsb.org https://data.rcsb.org https://search.rcsb.org https://www.ebi.ac.uk"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": {
      "../scientific/worker.py": "scientific/worker.py",
      "../scientific/engine-version.txt": "scientific/engine-version.txt",
      "../scientific/requirements-tested-macos-arm64.txt": "scientific/requirements-tested-macos-arm64.txt",
      "../fixtures/": "fixtures/",
      "../scientific/observatory.py": "scientific/observatory.py",
      "../scientific/chimerax_session.py": "scientific/chimerax_session.py",
      "../scientific/peptides.py": "scientific/peptides.py",
      "../scientific/amino-acids.json": "scientific/amino-acids.json",
      "../scientific/confidence.py": "scientific/confidence.py",
      "../scientific/molecular_graph.py": "scientific/molecular_graph.py",
      "../scientific/native_inventory.py": "scientific/native_inventory.py",
      "icons/icon.png": "icons/icon.png",
      "../scientific/scene_bridge.py": "scientific/scene_bridge.py",
      "../scientific/capability_audit.py": "scientific/capability_audit.py",
      "../scientific/pinned-capabilities-1.12.json": "scientific/pinned-capabilities-1.12.json",
      "../scientific/validation-evidence-4.2.json": "scientific/validation-evidence-4.2.json",
      "../scientific/intelligence.py": "scientific/intelligence.py",
      "../scientific/fold_engine.py": "scientific/fold_engine.py",
      "../scientific/fold_compute.py": "scientific/fold_compute.py",
      "../scientific/metal_attention.py": "scientific/metal_attention.py",
      "../vendor/bindcraft2/": "vendor/bindcraft2/",
      "../vendor/bindcraft2-source.json": "vendor/bindcraft2-source.json",
      "../vendor/openmm-runtime.json": "vendor/openmm-runtime.json",
      "../scientific/mpnn.py": "scientific/mpnn.py",
      "../scientific/mpnn_runner.py": "scientific/mpnn_runner.py",
      "../../runtime-build/python-jax/": "runtime/",
      "../../runtime-build/python-metaljax/": "runtime-metal/",
      "../../runtime-build/python-boltz/": "runtime-boltz/",
      "../../runtime-build/python-openmm/": "runtime-openmm/",
      "../scientific/boltz_resources.py": "scientific/boltz_resources.py",
      "../scientific/boltz-parameters.json": "scientific/boltz-parameters.json",
      "../scientific/bindcraft_cpu.py": "scientific/bindcraft_cpu.py",
      "../scientific/bindcraft_runner.py": "scientific/bindcraft_runner.py",
      "../scientific/af2_native.py": "scientific/af2_native.py",
      "../scientific/metal_runtime.py": "scientific/metal_runtime.py",
      "../scientific/campaign_progress.py": "scientific/campaign_progress.py",
      "../scientific/campaign_options.py": "scientific/campaign_options.py",
      "../scientific/campaign_profile.py": "scientific/campaign_profile.py",
      "../scientific/bindcraft_provenance.py": "scientific/bindcraft_provenance.py",
      "../../models/alphafold/": "models/alphafold/",
      "../scientific/af2-parameters.json": "scientific/af2-parameters.json",
      "../scientific/validation-evidence-current.json": "scientific/validation-evidence-current.json",
      "../scientific/mpnn_constraints.py": "scientific/mpnn_constraints.py",
      "../scientific/campaign_inputs.py": "scientific/campaign_inputs.py",
      "../scientific/sequence_targets.py": "scientific/sequence_targets.py",
      "../scientific/target_fragment.py": "scientific/target_fragment.py",
      "../scientific/campaign_scoring.py": "scientific/campaign_scoring.py",
      "../scientific/campaign_review.py": "scientific/campaign_review.py",
      "../scientific/campaign_archive.py": "scientific/campaign_archive.py",
      "../scientific/campaign_review_runner.py": "scientific/campaign_review_runner.py",
      "../scientific/campaign_recovery.py": "scientific/campaign_recovery.py",
      "../scientific/campaign_repeat.py": "scientific/campaign_repeat.py",
      "../scientific/ligand.py": "scientific/ligand.py",
      "../scientific/coordinate_ensemble.py": "scientific/coordinate_ensemble.py",
      "../scientific/dynamics.py": "scientific/dynamics.py",
      "../scientific/dynamics_runner.py": "scientific/dynamics_runner.py",
      "../scientific/trajectory_metrics.py": "scientific/trajectory_metrics.py",
      "../scientific/trajectory_analysis.py": "scientific/trajectory_analysis.py",
      "../scientific/ligand_runner.py": "scientific/ligand_runner.py"
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
