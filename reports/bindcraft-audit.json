  "declaredDependencies": "[project]\nname = \"bindcraft\"\nversion = \"1.0.3\"\nrequires-python = \">=3.12\"\ndependencies = [\n    \"jax>=0.11,<0.12\",\n    \"dm-haiku\",\n    \"optax\",\n    \"biotite\",\n    \"matplotlib\",\n    \"numpy\",\n    \"scipy\",\n    \"ml_collections\",\n    \"absl-py\",\n]\n\n[project.scripts]\nbindcraft = \"bindcraft.cli:main\"\n\n[project.optional-dependencies]\n# The GPU environment every recorded baseline was measured in carries jax-cuda13-plugin and\n# jax-cuda13-pjrt, so cuda13 is the extra that reproduces that stack.\n# jax[cuda1x] carries the matching cuDNN for the architecture it is installed on. cuEquivariance\n# does not ride along with it: cuequivariance-jax is pure python and its fused kernels come from an\n# ops wheel built against one CUDA major version, so the extra names the one that matches, and both\n# publish x86-64 and aarch64 builds.\ncuda12 = [\"jax[cuda12]>=0.11,<0.12\", \"cuequivariance-jax>=0.11,<0.12\", \"cuequivariance-ops-cu12>=0.11,<0.12\"]\ncuda13 = [\"jax[cuda13]>=0.11,<0.12\", \"cuequivariance-jax>=0.11,<0.12\", \"cuequivariance-ops-cu13>=0.11,<0.12\"]\nrocm = [\"jax[rocm7-local]>=0.11,<0.12\"]\ndocs = [\"sphinx\", \"furo\", \"myst-parser\", \"sphinx-copybutton\"]\n\n[build-system]\nrequires = [\"setuptools\"]\nbuild-backend = \"setuptools.build_meta\"\n\n#The package sits at the repository root, so discovery is told which top-level name is the package\n#and leaves containers, docs and examples alone.\n[tool.setuptools.packages.find]\ninclude = [\"bindcraft*\"]\n\n# ProteinMPNN rides along with the package so an installation redesigns sequences out of the box.\n# AlphaFold parameters are 5.3 GB and are downloaded on first use instead; weights/alphafold is\n# where a container bakes them.\n[tool.setuptools.package-data]\nbindcraft = [\"weights/proteinmpnn/*/*.npz\", \"weights/README.md\"]\n",
